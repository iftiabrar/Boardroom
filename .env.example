# ===== BoardRoom API environment =====
# .env holds real values and is never committed. .env.example is the shared template.

# --- App ---
NODE_ENV=development
NODE_DB_ENV=development
PORT=5001
APP_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=change_me_to_a_random_string

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=boardroom

# --- JWT ---
JWT_BEARER_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
# Still required by the boilerplate's zod schema until step A9 makes it optional
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# --- Admin seed (pnpm seed:admin) ---
ADMIN_EMAIL=admin@boardroom.test
ADMIN_PASSWORD=Admin@12345

# --- Mail (Mailtrap sandbox: Email Testing > Inboxes > SMTP settings) ---
MAILER_HOST=sandbox.smtp.mailtrap.io
MAILER_PORT=2525
MAILER_SECURE=false
MAILER_USER=your_mailtrap_user
MAILER_PASSWORD=your_mailtrap_password
MAILER_FROM="BoardRoom <no-reply@boardroom.test>"
