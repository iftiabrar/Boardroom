{
  "info": {
    "name": "BoardRoom",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "BoardRoom API checks. Run the folders top to bottom on a fresh database after pnpm migration:run and pnpm seed:admin."
  },
  "item": [
    {
      "name": "Part A: Auth, Users, Audit log",
      "item": [
        {
          "name": "1. Register new user (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().data.id);",
                  "pm.test(\"No password in response\", () => pm.expect(pm.response.text()).to.not.include(\"password\"));",
                  "pm.test(\"Has X-Request-Id and X-Response-Time headers\", () => { pm.response.to.have.header(\"X-Request-Id\"); pm.response.to.have.header(\"X-Response-Time\"); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// New email on every run, so register always works",
                  "pm.collectionVariables.set(\"userEmail\", \"user\" + Date.now() + \"@test.com\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Strong@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
